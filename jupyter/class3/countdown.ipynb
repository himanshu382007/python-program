   "source": [
    "def countdown(n):\n",
    "    while n >= 1:\n",
    "        yield n\n",
    "        n -= 1\n",
    "n = int(input(\"Enter a number: \"))\n",
    "for num in countdown(n):\n",
    "    print(num)"
   ]
  }
