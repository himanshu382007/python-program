    "def maximum(a, b):\n",
    "    if a > b:\n",
    "        return a\n",
    "    else:\n",
    "        return b\n",
    "num1 = int(input(\"Enter first number:\\n\"))\n",
    "print(\"Number 1 is\",num1)\n",
    "num2 = int(input(\"Enter second number:\\n\"))\n",
    "print(\"Number 2 is\",num2)\n",
    "result = maximum(num1, num2)\n",
    "print(\"Greater number:\", result)"
   ]
