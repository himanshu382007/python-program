    "#Replace_last\n",
    "# Take 5 fruits\n",
    "fruits = []\n",
    "for i in range(5):\n",
    "    x = input(\"Enter fruit: \")\n",
    "    fruits += [x]\n",
    "# Replace 2nd and 4th fruit\n",
    "fruits[1] = \"Mango\"\n",
    "fruits[3] = \"Mango\"\n",
    "# Print list\n",
    "print(fruits)"
