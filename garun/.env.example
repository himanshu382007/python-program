# ============================================
# Garun AI Assistant - Environment Variables
# ============================================
# Copy this file to .env and add your API keys

# ============================================
# AI PROVIDER SELECTION
# ============================================
# Choose your AI provider: "groq", "gemini", "openai"
AI_PROVIDER=groq

# ============================================
# API KEYS (Add at least one)
# ============================================

# Groq API Key (FREE - Fast Llama 3)
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (FREE tier available)
# Get yours at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Paid - GPT-4)
# Get yours at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# RECOMMENDATION
# ============================================
# For the best FREE experience, use:
# 1. Groq (Llama 3) - Fast and free
# 2. Gemini - Free tier available
